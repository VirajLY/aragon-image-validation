generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  UPLOADING
  PROCESSING
  COMPLETED
}

enum ImageStatus {
  PENDING
  PROCESSING
  ACCEPTED
  REJECTED
}

enum PipelineStatus {
  PENDING
  CONVERTING
  COMPRESSING
  GENERATING_VARIANTS
  READY
  FAILED
}

enum VariantType {
  THUMBNAIL
  WEB
  FULL
}

enum ValidationRule {
  FORMAT
  SIZE
  RESOLUTION
  BLUR
  FACE_TOO_SMALL
  MULTIPLE_FACES
  NO_FACE
  SIMILARITY
}

model UploadSession {
  id             String        @id @default(uuid()) @db.Uuid
  status         SessionStatus @default(UPLOADING)
  totalImages    Int           @default(0) @map("total_images")
  acceptedCount  Int           @default(0) @map("accepted_count")
  rejectedCount  Int           @default(0) @map("rejected_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  images         Image[]

  @@map("upload_sessions")
}

model Image {
  id               String             @id @default(uuid()) @db.Uuid
  sessionId        String             @map("session_id") @db.Uuid
  originalFilename String             @map("original_filename")
  storageKey       String             @map("storage_key")
  thumbnailKey     String?            @map("thumbnail_key")
  mimeType         String             @map("mime_type")
  fileSizeBytes    Int                @map("file_size_bytes")
  width            Int?
  height           Int?
  perceptualHash   String?            @map("perceptual_hash")
  status           ImageStatus        @default(PENDING)
  rejectionReason  String?            @map("rejection_reason")
  
  // Pipeline processing fields
  pipelineStatus   PipelineStatus     @default(PENDING) @map("pipeline_status")
  pipelineStage    String?            @map("pipeline_stage")
  pipelineError    String?            @map("pipeline_error")
  originalSize     Int?               @map("original_size")
  compressedSize   Int?               @map("compressed_size")
  compressionRatio Float?             @map("compression_ratio")
  convertedFormat  String?            @map("converted_format")

  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  
  session          UploadSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  validationResults ValidationResult[]
  variants         ImageVariant[]

  @@index([sessionId])
  @@index([status])
  @@index([pipelineStatus])
  @@index([perceptualHash])
  @@map("images")
}

model ValidationResult {
  id        String         @id @default(uuid()) @db.Uuid
  imageId   String         @map("image_id") @db.Uuid
  rule      ValidationRule
  passed    Boolean
  message   String?
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")
  image     Image          @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@map("validation_results")
}

model ImageVariant {
  id            String      @id @default(uuid()) @db.Uuid
  imageId       String      @map("image_id") @db.Uuid
  type          VariantType
  storageKey    String      @map("storage_key")
  url           String
  width         Int
  height        Int
  fileSizeBytes Int         @map("file_size_bytes")
  format        String
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  image         Image       @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([imageId, type])
  @@index([imageId])
  @@map("image_variants")
}
